# Select a provider and one of the model identifiers documented in README.md.
LLM_PROVIDER=ollama
LLM_MODEL=nemotron-3-nano:30b-cloud
LLM_MAX_ITERATIONS=6
LLM_TEMPERATURE=0.2

# Supply only the key for the selected provider.
OLLAMA_API_KEY=replace_with_ollama_cloud_api_key
GEMINI_API_KEY=replace_with_google_gemini_api_key
OPENAI_API_KEY=replace_with_openai_api_key
